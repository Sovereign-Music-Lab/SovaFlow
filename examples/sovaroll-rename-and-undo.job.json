{
  "schema": "sovaflow.job/1",
  "id": "sovaroll-rename-and-undo",
  "title": "Safe SovaRoll edit test: rename the project, then undo it",
  "intention": {"text": "Prove a SovaRoll edit is validated, applied, verified and undoable"},
  "steps": [
    {"id": "rename", "adapter": "sovaroll", "action": "command", "args": {"command": "project.rename", "arguments": {"name": "SovaFlow test name"}}},
    {"id": "undo", "adapter": "sovaroll", "action": "undo", "args": {"step": "rename"}}
  ],
  "policy": {"maxIterations": 1}
}
